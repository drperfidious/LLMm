+// lm_ggml_turbo_wht
+
+struct lm_ggml_tensor * lm_ggml_turbo_wht(
+        struct lm_ggml_context * ctx,
+        struct lm_ggml_tensor  * a,
+        int                      direction,
+        int                      group_size,
+        struct lm_ggml_tensor  * scale) {
+    LM_GGML_ASSERT(lm_ggml_is_contiguous(a));
+    LM_GGML_ASSERT(a->type == LM_GGML_TYPE_F32);
+    LM_GGML_ASSERT(direction == 0 || direction == 1);
+
+    if (group_size == 0) {
+        group_size = (a->ne[0] % 128 == 0) ? 128 : 64;
+    }
+    LM_GGML_ASSERT(group_size == 32 || group_size == 64 || group_size == 128);
+    LM_GGML_ASSERT(a->ne[0] % group_size == 0);
+
+    struct lm_ggml_tensor * result = lm_ggml_new_tensor(ctx, LM_GGML_TYPE_F32, 4, a->ne);
+
+    result->op     = LM_GGML_OP_TURBO_WHT;
+    result->src[0] = a;
+    result->src[1] = scale;
+
+    memcpy((char *) result->op_params + 0,           &direction,  sizeof(int));
+    memcpy((char *) result->op_params + sizeof(int), &group_size, sizeof(int));
+
+    return result;
+}
