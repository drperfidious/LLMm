<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>LLMm</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.4.1</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(REVERSED_GOOGLE_IOS_CLIENT_ID)</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.randyduquette.llmm.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>llmm</string>
				<string>pocketpal</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>148</string>
	<key>FIREBASE_ANALYTICS_COLLECTION_ENABLED</key>
	<false/>
	<key>GIDClientID</key>
	<string>$(GOOGLE_WEB_CLIENT_ID)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>LLMm connects to the local Metro development server while running debug builds on your device.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>LLMm may use your location when you enable location-based talents, such as local search or weather, to provide relevant on-device agent responses.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>LLMm can search your calendar on-device and create events only when you enable calendar talents and explicitly request them.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>LLMm can create calendar events only when you explicitly ask an agent to save one.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>LLMm can search your calendar on-device and create events only when you enable calendar talents and explicitly request them.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>LLMm can search and update reminders on-device only when you enable reminder talents and explicitly request them.</string>
	<key>NSAlarmKitUsageDescription</key>
	<string>LLMm can create app-owned alarms and timers only when you enable clock talents and explicitly request them.</string>
	<key>NSCameraUsageDescription</key>
	<string>LLMm uses your camera to capture images and video for local AI analysis only. All processing happens on your device and no images are transmitted to external servers.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>LLMm accesses your photo library to select images for local AI analysis only. Selected images are processed entirely on your device and are never transmitted to external servers.</string>
	<key>NSSiriUsageDescription</key>
	<string>LLMm uses Siri to let you ask questions to your local AI agents using voice commands.</string>
	<key>RCTNewArchEnabled</key>
	<true/>
	<key>UIAppFonts</key>
	<array>
		<string>MaterialIcons.ttf</string>
		<string>MaterialCommunityIcons.ttf</string>
		<string>Inter-Bold.ttf</string>
		<string>Inter-Light.ttf</string>
		<string>Inter-Medium.ttf</string>
